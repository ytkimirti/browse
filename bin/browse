#!/usr/bin/env bash
# browse — drive a REAL recorded browser step by step (see SKILL.md at the repo
# root). Every session is captured as a video with an animated cursor +
# keystroke overlay; on close, static "agent thinking" dead air is cut out into
# a shareable recording.mp4 (bracket a visibly-progressing wait with
# `browse speed <n>` … `browse speed off` to fast-forward it instead).
#
# Source lives in browse.mjs at the repo root. Everything browse owns — the
# Playwright npm install, sessions, profiles — lives under ~/.browse (override
# with BROWSE_HOME), so the clone stays a few files and `git clean` can't nuke
# it. The browser BINARIES are the one exception: they go to Playwright's
# shared per-user cache (~/Library/Caches/ms-playwright on macOS,
# ~/.cache/ms-playwright on Linux), so a Chromium you already downloaded for
# another project is reused instead of fetched twice. Deps install on first
# use; `browse setup` pre-installs them and checks the optional extras.

set -euo pipefail

# Pinned rather than floating: browse drives a lot of Playwright surface (video
# capture, init scripts, CDP) and a silent minor bump has broken it before.
# Bump deliberately, then re-run `browse setup`.
PW_VERSION="1.61.1"
# camoufox is BUILT AGAINST playwright 1.60.0 and its Firefox speaks that exact
# protocol — 1.61 sends `viewport.isMobile`, which the build rejects at launch.
# So the stealth engine gets its own pinned playwright-core alongside the main
# install; browse.mjs prefers it when driving camoufox.
CAMOU_PW_VERSION="1.60.0"
# …and that copy is then PATCHED so video recording works at all on camoufox
# (see patch_camoufox_pw). Bump this tag whenever the patch changes, so an
# already-installed copy gets re-patched instead of silently staying stale.
CAMOU_PATCH_TAG="screencast-ack-v1"

# resolve symlinks so this works when invoked via a PATH symlink (~/.local/bin)
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HOME_DIR="${BROWSE_HOME:-$HOME/.browse}"
PW_DIR="$HOME_DIR"                       # main Playwright + Chromium install
CAMOU_PW_DIR="$HOME_DIR/camoufox-pw"     # pinned playwright-core for camoufox

command -v node >/dev/null || {
  echo "browse: node is required on PATH (need v18+; https://nodejs.org)" >&2; exit 1; }
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
if (( NODE_MAJOR < 18 )); then
  echo "browse: node v18+ required (found v$(node -p process.versions.node))" >&2; exit 1
fi

# Which command is this? The flags that may precede it take a value or not, so
# finding it means walking them. Worth the walk: matching $1 alone missed
# `browse --remote <host> setup`, which runs over THERE, and so downloaded a
# browser here first. An unrecognised flag ends the walk with no command, which
# only falls through to the install below — never wrong, just unhelpful.
CMD=""; REMOTE_SEEN=""; CMD_AT=""
if (( $# )); then
  _argv=("$@"); _i=0
  while (( _i < ${#_argv[@]} )); do
    case "${_argv[$_i]}" in
      --remote) REMOTE_SEEN=1; _i=$((_i + 2)) ;;
      -s|--session|-p|--profile|--viewport|--type-delay|--idle) _i=$((_i + 2)) ;;
      --headful|--headless|--camoufox|--chromium|--cursor|--no-cursor|\
      --keylog|--no-keylog|--popups|--no-popups|--net|--no-net) _i=$((_i + 1)) ;;
      -*) break ;;
      *) CMD="${_argv[$_i]}"; CMD_AT="$_i"; break ;;
    esac
  done
fi

# `box` takes over the whole command line: hand scripts/box.mjs everything AFTER
# the word, dropping the browse-level flags that preceded it. Dispatched off the
# WALK, not off $1 — matching $1 meant `browse -s zz box ls` fell through to
# browse.mjs as "unknown command 'box'". The walk is also what keeps
# `browse -s box open …` working: there `box` is the SESSION name, so it is
# skipped and CMD is `open`.
if [[ "$CMD" == "box" ]]; then
  # --remote picks which MACHINE a command runs on, and `box` is the thing that
  # MAKES those machines — it always talks to the Upstash API from here. Dropping
  # it with the other flags would be the silent ignore browse refuses everywhere
  # else. (-s/-p and the launch flags are about a browser `box` never starts, so
  # those are simply not its business.)
  if [[ -n "$REMOTE_SEEN" || -n "${BROWSE_REMOTE:-}" ]]; then
    _box_args=("${@:CMD_AT+2}")   # what was written AFTER the word `box`
    _box_hint="browse box${_box_args[*]:+ ${_box_args[*]}}"
    echo "browse: 'box' makes the machines --remote points AT, so it takes no --remote of its own." >&2
    echo "browse: Run '$_box_hint' plain; use --remote <box-id>@… for the browse commands that drive it." >&2
    exit 1
  fi
  shift "$((CMD_AT + 1))"
  exec node "$REPO_ROOT/scripts/box.mjs" "$@"
fi

# `help` must never trigger a 400MB download — it is the first thing anyone runs
# after cloning. Same for version. (`-h`/`--version` and friends end the walk
# with no command, which the default below sends the same way.)
case "${CMD:-help}" in
  help|version)
    exec node "$REPO_ROOT/browse.mjs" "$@" ;;
esac

# `setup` aimed at a remote installs the deps on THAT machine, so this one needs
# none of it. Local `setup` is the block further down, which does the installing.
if [[ "$CMD" == "setup" && ( -n "$REMOTE_SEEN" || -n "${BROWSE_REMOTE:-}" ) ]]; then
  exec node "$REPO_ROOT/browse.mjs" "$@"
fi

# Is camoufox (the optional stealth engine) actually installed on this machine?
have_camoufox() {
  [[ -x "$HOME/.local/share/uv/tools/camoufox/bin/python" ]] && return 0
  python3 -c 'import camoufox' >/dev/null 2>&1
}

pkg_install() { # <dir> <spec…> — bun if present, else npm; both are quiet-ish
  local dir="$1"; shift
  mkdir -p "$dir"
  [[ -f "$dir/package.json" ]] || printf '{ "name": "browse-deps", "private": true }\n' > "$dir/package.json"
  if command -v bun >/dev/null; then (cd "$dir" && bun add "$@")
  else (cd "$dir" && npm install --no-fund --no-audit "$@"); fi
}

# On Linux the browser also needs system libraries (libatspi, libnss…) that a
# desktop already has and a container does not — without them Chromium dies at
# launch on "error while loading shared libraries", which is the first wall a
# remote box hits. Playwright installs them itself given root, so ask for that
# where it is both needed and free: root, or sudo that wants no password.
deps_flag() {
  [[ "$(uname -s)" == "Linux" ]] || return 0
  if [[ "$(id -u)" == "0" ]] || sudo -n true 2>/dev/null; then echo "--with-deps"; fi
}

install_main() {
  # ffmpeg bundle too: browse.mjs falls back to it for the mp4 finalize when no
  # system ffmpeg exists (system one still preferred — it can draw speed badges)
  pkg_install "$PW_DIR" "playwright@$PW_VERSION"
  # `bun x`, not `bunx`: a bun installed without its bunx shim (some container
  # images) would otherwise pass the `command -v bun` test and then die on the
  # very next line with "bunx: command not found".
  local deps; deps="$(deps_flag)"
  if command -v bun >/dev/null; then (cd "$PW_DIR" && bun x playwright install $deps chromium ffmpeg)
  else (cd "$PW_DIR" && npx --yes playwright install $deps chromium ffmpeg); fi
}

# Only worth the download once camoufox itself is on the machine — playwright-core
# alone can't do anything useful. Cheap (~10MB, no browser binaries).
install_camoufox_pw() { pkg_install "$CAMOU_PW_DIR" "playwright-core@$CAMOU_PW_VERSION"; patch_camoufox_pw; }

# Without this, camoufox records NOTHING — no error, just an empty video dir and
# a `close` that blamed ffmpeg. Two mismatches between Playwright's Firefox
# driver and camoufox's Juggler build, both confirmed by protocol trace:
#   1. camoufox requires `Page.screencastFrameAck` to carry the screencastId it
#      returned from startScreencast. Playwright sends the ack with no params,
#      camoufox rejects it, and unacked frames stop the stream dead.
#   2. camoufox's `Page.screencastFrame` has no `timestamp` field, so
#      Playwright's `timestamp * 1000` is NaN and no frame is ever written.
# Upstream fix is camoufox PR #707, unmerged and absent from every release as of
# beta.28 — so patch the pinned playwright-core we already own. Safe to do
# because the version is pinned EXACTLY: these strings can't drift underneath us.
patch_camoufox_pw() {
  node - "$CAMOU_PW_DIR/node_modules/playwright-core/lib/coreBundle.js" <<'PATCH_EOF' || return 1
const fs = require("fs");
const file = process.argv[2];
let src = fs.readFileSync(file, "utf8");
if (src.includes("__camouScreencastId")) process.exit(0); // already patched
const subs = [
  // remember the screencastId that startScreencast hands back
  [`this._session.sendMayFail("Page.startScreencast", { width: options2.width, height: options2.height, quality: options2.quality });`,
   `Promise.resolve(this._session.sendMayFail("Page.startScreencast", { width: options2.width, height: options2.height, quality: options2.quality })).then((r) => { this.__camouScreencastId = r && r.screencastId; });`],
  // …and echo it back on every ack (upstream firefox ignores the extra param)
  [`this._session.sendMayFail("Page.screencastFrameAck");`,
   `this._session.sendMayFail("Page.screencastFrameAck", this.__camouScreencastId ? { screencastId: this.__camouScreencastId } : void 0);`],
  // frames with no timestamp get wall-clock instead of NaN
  [`frameSwapWallTime: event.timestamp * 1e3,`,
   `frameSwapWallTime: (typeof event.timestamp === "number" ? event.timestamp * 1e3 : Date.now()),`],
];
for (const [from, to] of subs) {
  if (!src.includes(from)) {
    console.error("browse: camoufox video patch does not apply to this playwright-core — camoufox sessions will have no video");
    process.exit(1);
  }
  src = src.replace(from, to);
}
fs.writeFileSync(file, src);
PATCH_EOF
  printf '%s %s\n' "$CAMOU_PW_VERSION" "$CAMOU_PATCH_TAG" > "$CAMOU_PW_DIR/.patched"
}

# Compare the INSTALLED version against the pin, not just "does the dir exist".
# Otherwise bumping PW_VERSION above is a no-op forever on any machine that ran
# browse once — which defeats the point of pinning.
installed_version() { # <dir> <pkg>
  node -p "require('$1/node_modules/$2/package.json').version" 2>/dev/null || true
}
# The npm package being at the pin does NOT mean the browser it drives was ever
# downloaded: an interrupted `playwright install`, or a bun without its bunx
# shim, leaves the package installed and the binary missing. Claiming "installed"
# there costs a whole session — the daemon launches, dies on Playwright's own
# "Please run … playwright install" banner, and the caller reads that as browse
# being broken. So readiness means the package AND the binary.
chromium_present() {
  node -e "const p=require('$PW_DIR/node_modules/playwright').chromium.executablePath();process.exit(require('fs').existsSync(p)?0:1)" 2>/dev/null
}
main_installed()    { [[ "$(installed_version "$PW_DIR" playwright)" == "$PW_VERSION" ]] && chromium_present; }
# Ready means installed AT the pin AND carrying the current video patch — a copy
# from before the patch existed is worse than none, since it records nothing.
camoufox_pw_ready() {
  [[ "$(installed_version "$CAMOU_PW_DIR" playwright-core)" == "$CAMOU_PW_VERSION" ]] &&
  [[ "$(cat "$CAMOU_PW_DIR/.patched" 2>/dev/null)" == "$CAMOU_PW_VERSION $CAMOU_PATCH_TAG" ]]
}

# `browse install` — the first thing you run after cloning: put the CLI on PATH,
# link this clone in as an agent skill, then install the deps. One clone is both
# the CLI and the skill, so `git pull` updates them together and a symlink keeps
# that true. Idempotent; re-run it after adding another agent.
# `install` links THIS clone into THIS machine's PATH and skill dirs, so a
# --remote alongside it is meaningless — and, since install ends by running
# `setup`, honouring it would download a browser here for a session meant to run
# over there. That is the exact trap `browse --remote <host> setup` was fixed for.
if [[ "$CMD" == "install" && ( -n "$REMOTE_SEEN" || -n "${BROWSE_REMOTE:-}" ) ]]; then
  echo "browse: 'install' sets up THIS machine, so it takes no --remote. Run 'browse install' here," >&2
  echo "browse: then 'browse --remote <host> setup' to install the deps over there." >&2
  exit 1
fi

if [[ "$CMD" == "install" ]]; then
  shift "$((CMD_AT + 1))"
  BIN_DIR="${BROWSE_BIN_DIR:-$HOME/.local/bin}"
  mkdir -p "$BIN_DIR"
  ln -sfn "$SCRIPT_DIR/browse" "$BIN_DIR/browse"
  echo "browse: ✓ $BIN_DIR/browse"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) echo "browse: ! $BIN_DIR is not on your PATH — add it, or 'browse' won't be found" ;;
  esac
  # Skills live in a per-agent directory. With no argument, link into the two
  # that cover everything on this machine: Claude Code's, and ~/.agents/skills,
  # which the agents that read AGENTS.md share. Name dirs to override — a
  # project's own ./.agents/skills, say.
  DIRS=("$@")
  [[ ${#DIRS[@]} -eq 0 ]] && DIRS=("$HOME/.claude/skills" "$HOME/.agents/skills")
  for d in "${DIRS[@]}"; do
    mkdir -p "$d"
    # -n so an existing link is REPLACED rather than linked inside it. A real
    # directory there is someone else's install: say so instead of clobbering.
    if [[ -d "$d/browse" && ! -L "$d/browse" ]]; then
      echo "browse: ! $d/browse is a real directory, not a link — left alone"
    else
      ln -sfn "$REPO_ROOT" "$d/browse"
      echo "browse: ✓ $d/browse (skill)"
    fi
  done
  echo "browse: installing deps…"
  set -- setup
fi

# `set -- setup` from the install block lands here too, so CMD is re-derived
# rather than trusted.
[[ "${1:-}" == "setup" ]] && CMD="setup"
if [[ "$CMD" == "setup" ]]; then
  echo "browse: data home is $HOME_DIR"
  if main_installed; then
    echo "browse: ✓ playwright $PW_VERSION + chromium already installed"
  else
    have="$(installed_version "$PW_DIR" playwright)"
    if [[ "$have" == "$PW_VERSION" ]]; then
      # The package is at the pin but the BROWSER is missing: an interrupted
      # download, or a fresh browser cache. Saying "updating" here reads as a
      # no-op and hides the 170MB about to be fetched.
      echo "browse: playwright $PW_VERSION is installed but its chromium is not — fetching it…"
    elif [[ -n "$have" ]]; then
      echo "browse: playwright $have installed but $PW_VERSION is pinned — updating…"
    else
      echo "browse: installing playwright $PW_VERSION + chromium (one-time, ~2 min)…"
    fi
    install_main
    echo "browse: ✓ playwright $PW_VERSION + chromium"
  fi
  if have_camoufox; then
    if camoufox_pw_ready; then
      echo "browse: ✓ camoufox stealth engine ready (video recording patched in)"
    else
      echo "browse: camoufox found — installing its pinned playwright-core ${CAMOU_PW_VERSION}…"
      # A failed patch is not fatal: camoufox still drives pages, it just can't
      # record. Say so here rather than letting `close` blame ffmpeg later.
      if install_camoufox_pw; then
        echo "browse: ✓ camoufox stealth engine ready (video recording patched in)"
      else
        echo "browse: ! camoufox linked but the video patch failed — camoufox sessions will not record."
        echo "browse:   Use BROWSE_ENGINE=chromium for anything you need a video of."
      fi
    fi
  else
    echo "browse: • camoufox not installed — the default engine will be chromium."
    echo "browse:   For headless bot-wall bypass:"
    echo "browse:     uv tool install camoufox"
    echo "browse:     ~/.local/share/uv/tools/camoufox/bin/python -m camoufox fetch"
    echo "browse:   then re-run 'browse setup' to link it."
  fi
  command -v ffmpeg >/dev/null \
    && echo "browse: ✓ system ffmpeg" \
    || echo "browse: • no system ffmpeg — mp4 finalize uses playwright's bundled copy (brew install ffmpeg for speed badges)"
  echo "browse: ready — try 'browse open https://example.com'"
  exit 0
fi

if ! main_installed; then
  echo "browse: installing playwright $PW_VERSION + chromium into $HOME_DIR (one-time, ~2 min)…" >&2
  install_main >&2
fi
# camoufox can be installed long after browse was; pick it up without a manual
# setup re-run, since silently falling back to chromium is exactly the failure
# mode this is here to prevent.
if have_camoufox && ! camoufox_pw_ready; then
  echo "browse: linking camoufox to its pinned playwright-core $CAMOU_PW_VERSION (one-time)…" >&2
  install_camoufox_pw >&2 || echo "browse: camoufox video patch failed — its sessions will not record (BROWSE_ENGINE=chromium to be sure)" >&2
fi

# playwright is resolved from the data home, not next to the source file
BROWSE_PW_BASE="$PW_DIR/package.json" exec node "$REPO_ROOT/browse.mjs" "$@"
