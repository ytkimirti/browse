#!/usr/bin/env bash
# browse-box — the Upstash Box side of `browse --remote`: bring a box up, put
# files on it, run its dev server, stop it when the session ends.
# `browse-box help` is the command surface; the source is scripts/box.mjs.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

command -v node >/dev/null || {
  echo "browse-box: node is required on PATH (need v18+; https://nodejs.org)" >&2; exit 1; }

exec node "$REPO_ROOT/scripts/box.mjs" "$@"
